# Build context: the parent Projects directory.
FROM golang:1.25 AS source
WORKDIR /src
COPY Fiber/ Fiber/
COPY Pulp-Lua/ Pulp-Lua/
COPY Peel/ Peel/
COPY pulp-engines/ pulp-engines/

FROM source AS relay
WORKDIR /src/pulp-engines/routed-udp-relay-host-cell
RUN GOOS=wasip1 GOARCH=wasm go build -buildmode=c-shared -o routed-udp-relay.wasm .

FROM source AS state
WORKDIR /src/pulp-engines/routing-state-sqlite-cell
RUN GOOS=wasip1 GOARCH=wasm go build -buildmode=c-shared -o routing-state.wasm .

FROM source AS api
WORKDIR /src/Peel/api-cell
RUN GOOS=wasip1 GOARCH=wasm go build -buildmode=c-shared -o peel-api.wasm .

FROM source AS httpjson
WORKDIR /src/pulp-engines/http-json-cell
RUN GOOS=wasip1 GOARCH=wasm go build -buildmode=c-shared -o http-json.wasm .

FROM source AS lua
WORKDIR /src/Pulp-Lua/pulp-cell
RUN GOOS=wasip1 GOARCH=wasm go build -buildmode=c-shared -o lua-orchestrator.wasm .

FROM golang:1.25 AS host
WORKDIR /src
COPY Pulp/ Pulp/
COPY Pulp-ext-http/ Pulp-ext-http/
COPY Pulp-ext-sqlite/ Pulp-ext-sqlite/
COPY Pulp-ext-udp/ Pulp-ext-udp/
COPY Peel/pulp-deployment/ Peel/pulp-deployment/
WORKDIR /src/Peel/pulp-deployment
RUN CGO_ENABLED=0 go build -o /out/peel-host .

FROM alpine:3.20
RUN apk add --no-cache ca-certificates
WORKDIR /app
COPY --from=host /out/peel-host /app/peel-host
COPY Peel/application/ /app/application/
COPY pulp-engines/routed-udp-relay-host-cell/pulp.cell.toml /pulp-engines/routed-udp-relay-host-cell/pulp.cell.toml
COPY pulp-engines/routing-state-sqlite-cell/pulp.cell.toml /pulp-engines/routing-state-sqlite-cell/pulp.cell.toml
COPY Peel/api-cell/pulp.cell.toml /app/api-cell/pulp.cell.toml
COPY pulp-engines/http-json-cell/pulp.cell.toml /pulp-engines/http-json-cell/pulp.cell.toml
COPY --from=relay /src/pulp-engines/routed-udp-relay-host-cell/routed-udp-relay.wasm /pulp-engines/routed-udp-relay-host-cell/routed-udp-relay.wasm
COPY --from=state /src/pulp-engines/routing-state-sqlite-cell/routing-state.wasm /pulp-engines/routing-state-sqlite-cell/routing-state.wasm
COPY --from=api /src/Peel/api-cell/peel-api.wasm /app/api-cell/peel-api.wasm
COPY --from=httpjson /src/pulp-engines/http-json-cell/http-json.wasm /pulp-engines/http-json-cell/http-json.wasm
COPY --from=lua /src/Pulp-Lua/pulp-cell/lua-orchestrator.wasm /app/application/lua-orchestrator.wasm
RUN chmod +x /app/peel-host
ENV HTTP_PORT=8080
EXPOSE 8080 5520/udp
HEALTHCHECK --interval=30s --timeout=5s CMD wget -qO- http://localhost:${HTTP_PORT}/health || exit 1
CMD ["/app/peel-host", "-app", "/app/application/pulp.app.toml"]
